# Copy to .env and fill in. Restart Expo with `npx expo start --clear` after changing.
# Anything prefixed EXPO_PUBLIC_ is bundled into the app and readable by anyone
# who downloads it. Never put a secret behind that prefix.

# Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
